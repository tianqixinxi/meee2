{
  "name": "meee2-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:web": "pnpm -r --filter @meee1/board-app... build",
    "build:dev": "bash scripts/gen-build-info.sh && pnpm run build && swift build",
    "dev:web": "pnpm -F @meee1/board-app dev",
    "dev:shell": "./scripts/dev-board-shell.sh",
    "restart:dev": "pnpm run build:dev && ./scripts/dev-restart.sh",
    "publish:packages": "pnpm run build && pnpm -r --filter './packages/*' publish --access public --no-git-checks",
    "typecheck": "pnpm -r --filter './packages/*' typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@meee1/board-core": "^0.1.1",
    "@meee1/board-persistence-http": "^0.1.1"
  }
}
