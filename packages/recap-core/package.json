{
  "name": "@meee1/recap-core",
  "version": "0.1.0",
  "description": "Cross-platform recap domain contracts and pure recap logic for meee2 workspaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "default": "./dist/canvas.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./fingerprint": {
      "types": "./dist/fingerprint.d.ts",
      "default": "./dist/fingerprint.js"
    },
    "./monitor": {
      "types": "./dist/monitor.d.ts",
      "default": "./dist/monitor.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node test/monitor.test.mjs && node test/session.test.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
