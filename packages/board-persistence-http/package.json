{
  "name": "@meee1/board-persistence-http",
  "version": "0.1.0",
  "description": "HTTP + localStorage backed CanvasPersistence implementation for the meee2 Swift board backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@meee1/board-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
