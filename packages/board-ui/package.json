{
  "name": "@tianqixinxi/board-ui",
  "version": "0.1.0",
  "description": "Headless React board canvas — Excalidraw shell + persistence wiring + scene sync, with render slots for app-specific UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./BoardCanvas": {
      "types": "./dist/BoardCanvas.d.ts",
      "default": "./dist/BoardCanvas.js"
    },
    "./CardHost": {
      "types": "./dist/CardHost.d.ts",
      "default": "./dist/CardHost.js"
    },
    "./SessionInspector": {
      "types": "./dist/SessionInspector.d.ts",
      "default": "./dist/SessionInspector.js"
    },
    "./TranscriptView": {
      "types": "./dist/TranscriptView.d.ts",
      "default": "./dist/TranscriptView.js"
    },
    "./SessionInspector.css": "./src/SessionInspector.css",
    "./TranscriptView.css": "./src/TranscriptView.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@tianqixinxi/board-core": "workspace:*",
    "@tianqixinxi/board-cards": "workspace:*"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "react-markdown": "^10.0.0",
    "react-diff-viewer-continued": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "highlight.js": "^11.0.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "highlight.js": "^11.11.1",
    "react": "19.2.4",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5"
  }
}
