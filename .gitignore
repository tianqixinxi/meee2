# Web frontend (Wave 10b) — node_modules + intermediate build dirs.
node_modules/
packages/*/dist/
packages/*/.vite/
packages/*/tsconfig.tsbuildinfo

# Vite output bundle. Generated by `pnpm -F @meee1/board-app build` (or
# implicitly by build.sh / create-dmg.sh / ci.yml validate job). Was
# committed historically (Wave 10b) which made every release a 100+ file
# rename diff with hashed chunk names — pure noise. CI & release builds
# regenerate it before swift build, so it doesn't need to be tracked.
# .gitkeep preserves the directory so Package.swift's `.copy("Board/WebDist")`
# doesn't fail on a fresh clone before pnpm build runs.
Sources/Board/WebDist/*
!Sources/Board/WebDist/.gitkeep

# Claude Code 本地配置 + 子 agent worktree
.claude/
Bridge/mcp-meee2/node_modules/
