{
  "manifest_version": 3,
  "name": "Meee2 web chat bridge",
  "version": "0.1.0",
  "description": "Sync ChatGPT and Claude.ai conversations to your local Meee2 board.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/content-chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content-claude-web.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Meee2 web chat bridge",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
