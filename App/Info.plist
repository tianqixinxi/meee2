<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>meee2</string>
    <key>CFBundleDisplayName</key>
    <string>Meee2</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.meee2.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Meee2</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0-dev</string>
    <!-- CFBundleVersion 必须跟 CFBundleShortVersionString 同步：Sparkle 比版本
         时优先看 CFBundleVersion；不一致会让 Settings 的 VersionChecker 跟
         Sparkle 的判断分裂（前者比 ShortVersion 字符串，后者比 Bundle build
         number）。create-dmg.sh / deploy.sh 都把这两个字段一并 plutil 覆写
         成同一个 VERSION 值。源里这个 0.0.0-dev 只是占位，dev 直接 swift
         build 跑测试时不会生效到 Info.plist —— release 流程注入。 -->
    <key>CFBundleVersion</key>
    <string>0.0.0-dev</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Apple Events automation usage description. Triggered the first time
         meee2 sends Apple events to other apps (Ghostty / iTerm2 / Terminal
         for session focus + jump, Claude.app for the explicit "Push to
         Desktop now" keystroke flow). Without this key the privacy prompt
         has no explainer and reads as suspicious. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Meee2 scripts terminal apps and Claude.app to focus session windows and to deliver messages typed in the Meee2 board into the running session.</string>

    <!-- Sparkle auto-update. SUFeedURL is the appcast.xml that lives on the
         dedicated appcast branch (raw-served by GitHub) — release.yml's
         Sparkle publish step appends a new <item> after each notarized DMG
         lands on Releases. SUPublicEDKey verifies sign_update's EdDSA
         signature on download; rotating it requires regenerating the matching
         private key (kept in macOS Keychain locally + GH Secret
         SPARKLE_ED_PRIVATE_KEY_BASE64 for CI). -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/tianqixinxi/meee2/appcast/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>NA19lgoaQ0LSrt5Z0ARJuHaTrce96npVqcGg809aCoQ=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- 1 小时轮询。Sparkle 在启动后 SUScheduledCheckInterval 之后才发起
         首次"自动 check",所以这个值就是用户感知到的"多久才知道有新版"的
         上限。86400(24h)对 dev 太长(改完 release 第二天才看见 pill);
         3600 对生产用户也合理(更新很少这么频繁)。 -->
    <key>SUScheduledCheckInterval</key>
    <integer>3600</integer>
    <!-- Codex 风格 Update pill 体验的关键:Sparkle 1h 本地轮询或启动后的
         background check 发现新版后,
         自动下载 + EdDSA 验签,把 staged update 缓存到本地。用户点 pill
         时 Sparkle 跳过"下载进度"环节,custom user driver 自动确认 install,
         app 立即 apply 已下好的包并重启。
         没这个 key 的话:点 pill 才开始下载 → 用户要等几十秒。
         (注:zero-click 体验依赖 App/SilentInstallUserDriver.swift。) -->
    <key>SUAutomaticallyUpdate</key>
    <true/>
</dict>
</plist>
