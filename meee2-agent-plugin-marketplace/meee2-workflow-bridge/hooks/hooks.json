{
  "description": "Intercept native Workflow tool calls and relay them to a meee2 session for execution",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/intercept-workflow.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
